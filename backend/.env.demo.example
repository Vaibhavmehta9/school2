# Demo Tunnel Backend Environment Variables Template
# Copy to backend/.env.demo or add these settings to your backend environment

# Demo mode disables /docs, /redoc, and /openapi.json
DEMO_MODE=true

# Isolated database copy with sanitized / demo records only
DATABASE_PATH=sheerwood.demo.db

# Strict CORS: allow your tunnel origin and local preview
ALLOWED_ORIGINS=https://your-tunnel-domain.ngrok-free.app,http://localhost:4173,http://127.0.0.1:4173

# AI chat rate limit per IP to protect Gemini / LLM quota
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=300

# Payment in Easebuzz test mode
EASEBUZZ_ENV=test

