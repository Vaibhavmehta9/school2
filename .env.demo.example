# Demo Tunnel Frontend Environment Variables Template
# Copy this file to .env.demo or pass variables when building for demo

# Tunnel public HTTPS URL (e.g., https://sherwood-demo.ngrok-free.app)
VITE_SITE_URL=https://your-tunnel-domain.ngrok-free.app

# Cognito Redirect and Logout URIs for the Tunnel Host
# (If omitted, the app dynamically uses window.location.origin)
VITE_COGNITO_REDIRECT_URI=https://your-tunnel-domain.ngrok-free.app/
VITE_COGNITO_LOGOUT_URI=https://your-tunnel-domain.ngrok-free.app/signed-out

# Chat Streaming Setting:
# Set to "true" for ngrok (native SSE support)
# Set to "false" if using Cloudflare Quick Tunnel (avoids SSE buffering hangs)
VITE_CHAT_STREAMING=true

